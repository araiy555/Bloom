# Bloom backend env

# Use SQLite for quick start, or PostgreSQL for production:
# DATABASE_URL=postgresql+psycopg://bloom:bloom@db:5432/bloom
DATABASE_URL=sqlite:///./bloom.db

SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Where uploaded files are stored on disk (mounted volume in docker)
UPLOAD_DIR=./uploads

# AI providers (at least one of the keys must be set for chat to work)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default chat model
DEFAULT_PROVIDER=openai
DEFAULT_OPENAI_MODEL=gpt-4o-mini
DEFAULT_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Allowed CORS origins (comma separated)
CORS_ORIGINS=http://localhost:3000
